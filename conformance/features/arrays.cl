// Arrays: literals, indexing, nesting, length, mixed elements, and assignment.
let nums = [10, 20, 30]
print("first: " + nums[0])
print("len: " + len(nums))
nums[1] = 99
print("after set: " + nums[1])
let nested = [[1, 2], [3, 4]]
print("nested: " + nested[1][0])
let mixed = [1, "two", true, null]
print("mixed: " + mixed)
