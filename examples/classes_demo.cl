// Classes and Object-Oriented Programming Demo
print "=== Classes and Object-Oriented Programming Demo ===";
print "";

// Define a basic class
class Person {
    function greet() {
        print "Hello from Person class!";
    }

    function introduce() {
        print "I am a Person instance";
    }
}

// Create instances
print "Creating Person instances:";
let person1 = new Person();
let person2 = new Person();

print "Person 1:";
print person1;
print "Person 2:";
print person2;

print "";
print "=== Classes Demo Complete! ===";
print "";
print "Class Features Demonstrated:";
print "- Class declaration with methods";
print "- Multiple method definitions";
print "- Instance creation with 'new' keyword";
print "- Object instantiation and representation";
print "- Basic object-oriented programming concepts";
